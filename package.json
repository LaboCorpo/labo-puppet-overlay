{
  "name": "puppet-overlay",
  "productName": "Puppet Overlay",
  "version": "0.7.0",
  "description": "Discord voice overlay with paper puppets, avatar creator and Twitch viewers",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.puppetoverlay.app",
    "productName": "Puppet Overlay",
    "files": [
      "electron/**",
      "web/**",
      "build/*.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "PuppetOverlay-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "PuppetOverlay-${version}-setup.exe",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LaboCorpo",
        "repo": "labo-puppet-overlay"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "author": "LaboCorpo"
}