{
  "name": "labohub",
  "productName": "LaboHub",
  "version": "1.8.0",
  "description": "LaboHub: Discord voice puppets, Twitch viewer puppets and optional streaming tools (OBS widgets, alerts, stream deck, chat bot)",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node tools/check.js",
    "dist": "electron-builder --win portable nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.puppetoverlay.app",
    "productName": "LaboHub",
    "files": [
      "electron/**",
      "web/**",
      "build/*.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "LaboHub-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "LaboHub-${version}-setup.exe",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "LaboCorpo",
        "repo": "labo-puppet-overlay"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "author": "LaboCorpo"
}
